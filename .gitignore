__pycache__/
*.pyc
config.json
state.json
pending_todos.json
sync.log
canvas-deadlines.ics

# 虚拟环境
.venv/
venv/

# 打包产物（pip install . 会在源码目录留下这些）
build/
dist/
*.egg-info/
.eggs/

# PyInstaller 生成的构建文件（由命令行参数重建）
*.spec
# 但主 spec 必须入库：里面写的「要带上 playwright driver / tzdata」就是分发
# 正确性本身，重建时不能靠脑记
!CanvasHelper.spec
# 快捷方式带本机绝对路径，只入库生成脚本 scripts/make_shortcut.ps1
*.lnk

# 登录凭据正常存放在 %LOCALAPPDATA%（仓库之外），这里只是兜底：
# 万一有人把 session.json / 浏览器 profile 拷进源码目录，也不会被提交
session.json
profile/
